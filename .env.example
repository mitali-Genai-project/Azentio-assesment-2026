# Copy to .env and replace every placeholder. .env is git-ignored; never commit real values.

# PostgreSQL
DB_NAME=clearlist
DB_USERNAME=clearlist
DB_PASSWORD=<choose-a-db-password>
DB_URL=jdbc:postgresql://localhost:5432/clearlist

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=<choose-a-redis-password>

# Screening cache: redis | memory | none ; TTL as ISO-8601 duration
CACHE_TYPE=redis
CACHE_TTL=PT10M

# Matching tunables (defaults shown)
MATCH_THRESHOLD=0.85
MATCH_TOKEN_THRESHOLD=0.88
MATCH_MAX_HITS=10

# In-memory API users (HTTP Basic): analyst / supervisor
CLEARLIST_ANALYST_PASSWORD=<choose-an-analyst-password>
CLEARLIST_SUPERVISOR_PASSWORD=<choose-a-supervisor-password>

# Python summary service LLM provider: fake (default, deterministic, offline) | ollama (local, no API key)
SUMMARY_PROVIDER=fake
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT_SECONDS=30
